{
  "expo": {
    "name": "inspection-ai-mobile",
    "slug": "inspection-ai-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "inspectionaimobile",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AI Inspection to choose an existing video for this assessment.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
